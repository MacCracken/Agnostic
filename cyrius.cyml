[package]
name = "agnostic"
version = "${file:VERSION}"
description = "agnostic — TODO"
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.5.32"

[build]
entry = "src/main.cyr"
test = "src/test.cyr"
output = "agnostic"

[deps]
stdlib = ["string", "fmt", "alloc", "io", "vec", "str", "syscalls", "assert", "bench"]
