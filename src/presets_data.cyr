# The `i`th embedded preset document as a NUL-terminated C string, or 0 when
# `i` is out of range.
#
# A chain rather than a table because a `var` array of string literals has no
# spelling in Cyrius, and the only caller is a one-shot loop at mount.
fn agnostic_preset_json(i): i64 {
    if (i == 0) { return _AGNOSTIC_PRESET_JSON_00; }
    if (i == 1) { return _AGNOSTIC_PRESET_JSON_01; }
    if (i == 2) { return _AGNOSTIC_PRESET_JSON_02; }
    if (i == 3) { return _AGNOSTIC_PRESET_JSON_03; }
    if (i == 4) { return _AGNOSTIC_PRESET_JSON_04; }
    if (i == 5) { return _AGNOSTIC_PRESET_JSON_05; }
    if (i == 6) { return _AGNOSTIC_PRESET_JSON_06; }
    if (i == 7) { return _AGNOSTIC_PRESET_JSON_07; }
    if (i == 8) { return _AGNOSTIC_PRESET_JSON_08; }
    if (i == 9) { return _AGNOSTIC_PRESET_JSON_09; }
    if (i == 10) { return _AGNOSTIC_PRESET_JSON_10; }
    if (i == 11) { return _AGNOSTIC_PRESET_JSON_11; }
    if (i == 12) { return _AGNOSTIC_PRESET_JSON_12; }
    if (i == 13) { return _AGNOSTIC_PRESET_JSON_13; }
    if (i == 14) { return _AGNOSTIC_PRESET_JSON_14; }
    if (i == 15) { return _AGNOSTIC_PRESET_JSON_15; }
    if (i == 16) { return _AGNOSTIC_PRESET_JSON_16; }
    if (i == 17) { return _AGNOSTIC_PRESET_JSON_17; }
    return 0;
}
