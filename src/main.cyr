# agnostic — main entry point
# Stdlib auto-included via cyrius.cyml
#
# Include order is leaves-before-hubs. Cyrius resolves function forward
# references across a translation unit, but a top-level `var` initialiser that
# reads a global declared later silently evaluates to 0 — so a module holding
# state another module reads must be included first.
include "src/strcase.cyr"
include "src/config.cyr"
include "src/trace.cyr"
include "src/log.cyr"
include "src/http/status.cyr"
include "src/http/response.cyr"
include "src/http/codec.cyr"
include "src/routes/health.cyr"

# Entry point. Initialises the allocator and returns the process exit code.
fn main() {
    alloc_init();
    # CYRIUS_PKG_VERSION resolves only in this file — the entry text. Hand it to
    # the modules that need it at mount. See src/routes/health.cyr.
    agnostic_version_set(str_from(CYRIUS_PKG_VERSION));
    println("hello from agnostic");
    return 0;
}

# Prefixed deliberately: this is a top-level `var` in Cyrius's single flat
# namespace, so a bare `r` here is a global that could shadow — or be shadowed
# by — any dep that happens to use the same name. `scripts/check-symbols.sh`
# enforces the rule.
var _agnostic_exit_code = main();
# sys_exit_group, not syscall(SYS_EXIT, ...): SYS_EXIT ends only the calling
# thread, so the bare syscall hangs once this program spawns its first worker.
sys_exit_group(_agnostic_exit_code);
