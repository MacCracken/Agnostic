# agnostic/auth/webhook — HMAC-SHA256 signatures for outbound callbacks.
#
# ## ⚠ A bare body signature is replayable, so the timestamp is SIGNED
#
# `HMAC(secret, body)` proves the body came from someone holding the secret. It
# does not prove *when*, so a captured request can be replayed forever and the
# signature still verifies. The signed value is therefore `"<ts>.<body>"`, and
# verification enforces a freshness window — the scheme Stripe and GitHub both
# settled on, for this reason.
#
# ⚠ **The timestamp is inside the MAC, not beside it.** Sending `t` as an
# unsigned header field next to the signature would let an attacker replay an
# old body with a fresh `t`, which is the whole attack the window was meant to
# stop.
#
# ## Header form
#
#   X-Agnostic-Signature: t=<unix-secs>,v1=<hex-sha256>
#
# `v1` is a version tag, present so a future scheme can be introduced without
# ambiguity about what a bare hex string meant.
#
# ## ⚠ The comparison is constant-time on the hex, and the window is checked FIRST
#
# An early-exit compare leaks the signature prefix a byte at a time, which is a
# forgery oracle. Checking the window before the MAC also means a flood of stale
# replays costs a parse rather than a hash.

var AGNOSTIC_WEBHOOK_TOLERANCE_SECS = 300;

# The signature for `body` at `ts`, as lowercase hex, in arena `a`. 0 on failure.
fn agnostic_webhook_sign_a(a, wsecret: Str, ts, body: Str): i64 {
    if (wsecret == 0 || body == 0) { return 0; }
    if (str_len(wsecret) == 0) { return 0; }

    var tss = str_from_int_a(a, ts);
    var n = str_len(tss) + 1 + str_len(body);
    var buf = alloc_via(a, n);
    if (buf == 0) { return 0; }
    memcpy(buf, str_data(tss), str_len(tss));
    store8(buf + str_len(tss), 46);
    if (str_len(body) > 0) { memcpy(buf + str_len(tss) + 1, str_data(body), str_len(body)); }

    var mac = alloc_via(a, 32);
    if (mac == 0) { return 0; }
    hmac_sha256(str_data(wsecret), str_len(wsecret), buf, n, mac);
    return agnostic_hex_a(a, mac, 32);
}

# The full header value for `body` at `ts`, in arena `a`. 0 on failure.
fn agnostic_webhook_header_a(a, wsecret: Str, ts, body: Str): i64 {
    var sig = agnostic_webhook_sign_a(a, wsecret, ts, body);
    if (sig == 0) { return 0; }
    var tss = str_from_int_a(a, ts);
    var n = 2 + str_len(tss) + 4 + str_len(sig);
    var buf = alloc_via(a, n);
    if (buf == 0) { return 0; }
    memcpy(buf, str_data(str_from("t=")), 2);
    memcpy(buf + 2, str_data(tss), str_len(tss));
    memcpy(buf + 2 + str_len(tss), str_data(str_from(",v1=")), 4);
    memcpy(buf + 2 + str_len(tss) + 4, str_data(sig), str_len(sig));
    return str_new_a(a, buf, n);
}

# The value of `field=` in a `k=v,k=v` header, as a Str in `a`. 0 when absent.
fn _agnostic_webhook_field_a(a, header: Str, field): i64 {
    var p = str_data(header);
    var n = str_len(header);
    var fn_len = strlen(field);
    var i = 0;
    while (i < n) {
        # A field starts at the beginning or just after a comma.
        var at_start = 0;
        if (i == 0) { at_start = 1; }
        else { if ((load8(p + i - 1) & 255) == 44) { at_start = 1; } }
        if (at_start == 1) {
            if (i + fn_len < n) {
                var j = 0;
                var same = 1;
                while (j < fn_len) {
                    if ((load8(p + i + j) & 255) != (load8(field + j) & 255)) { same = 0; j = fn_len; }
                    j = j + 1;
                }
                if (same == 1) {
                    var s = i + fn_len;
                    var e = s;
                    while (e < n) {
                        if ((load8(p + e) & 255) == 44) { e = n; }
                        else { e = e + 1; }
                    }
                    # `e` overshoots to n when it hit a comma; recompute exactly.
                    var end = s;
                    while (end < n) {
                        if ((load8(p + end) & 255) == 44) { end = end; break; }
                        end = end + 1;
                    }
                    if (end <= s) { return 0; }
                    return str_new_a(a, p + s, end - s);
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

# Verify a signature header against `body` at `now`. 1 when good, 0 otherwise.
#
# ⚠ **The freshness window is enforced before the MAC is computed.** A replay
# flood should cost a parse, not a hash, and a stale signature is refused
# whether or not it was ever valid.
fn agnostic_webhook_verify_a(a, wsecret: Str, body: Str, header: Str, now, tolerance): i64 {
    if (wsecret == 0 || body == 0 || header == 0) { return 0; }
    if (str_len(header) == 0) { return 0; }

    var tss = _agnostic_webhook_field_a(a, header, "t=");
    if (tss == 0) { return 0; }
    var sig = _agnostic_webhook_field_a(a, header, "v1=");
    if (sig == 0) { return 0; }

    var ts = str_to_int(tss);
    if (ts <= 0) { return 0; }
    var skew = now - ts;
    if (skew < 0) { skew = 0 - skew; }
    if (skew > tolerance) { return 0; }

    var want = agnostic_webhook_sign_a(a, wsecret, ts, body);
    if (want == 0) { return 0; }
    return ct_eq_bytes_lens(str_data(want), str_len(want), str_data(sig), str_len(sig));
}
