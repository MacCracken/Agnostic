# agnostic/engine/store — the one patra handle everything durable shares.
#
# ## Why the handle is here rather than in whichever module opened it first
#
# `src/engine/definitions.cyr` owned it through M4's first half. Crew outcomes
# then needed durability too, and the alternatives were both worse than moving
# it: a second `patra_open` on the same file puts two flock-arbitrated handles
# in one process, and a second *file* multiplies the operator's backup surface
# for no reason. patra allows 63 tables per database (`MAX_TABLES`), so one
# handle and two tables is the shape.
#
# The audit chain is the deliberate exception — `patrastore_open` opens its own
# handle and owns its own schema, so it gets its own file. That is libro's call,
# not ours.
#
# ## patra_init used to stomp the host's log level — fixed upstream
#
# Its last line was an unconditional `sakshi_set_level(SK_WARN)`, so opening the
# database silently threw away whatever `AGNOSTIC_LOG_LEVEL` had set, including
# the `listening` line. This module saved and restored the level around the call
# as a work-around.
#
# **Fixed in patra 1.13.10**, which reaches `lib/` through the Cyrius 6.5.34
# fold, so the work-around is gone. Recorded rather than deleted outright because
# the failure was invisible — no error, just missing log lines — and a future
# reader seeing a bare `patra_init()` should know it was once not safe.

# The shared handle. 0 until mount opens it.
var _agnostic_store_db = 0;

# Open the database. Mount time only, before any worker exists.
#
# Returns 1 on success, 0 when the file cannot be opened. Idempotent.
fn agnostic_store_open(path: Str): i64 {
    if (_agnostic_store_db != 0) { return 1; }

    patra_init();

    var db = patra_open(str_data(path));
    if (db == 0) { return 0; }
    _agnostic_store_db = db;
    return 1;
}

# The handle, or 0 when nothing is open.
#
# ⚠ Every caller must treat 0 as "no persistence" and say so rather than
# reporting a write that did not happen.
fn agnostic_store_db(): i64 {
    return _agnostic_store_db;
}

# Close the database, flushing anything batched.
fn agnostic_store_close(): i64 {
    if (_agnostic_store_db == 0) { return 0; }
    patra_close(_agnostic_store_db);
    _agnostic_store_db = 0;
    return 0;
}

# Run a schema statement, tolerating "already exists".
#
# ⚠ `CREATE TABLE` on an existing table answers `PATRA_ERR_EXISTS`, which is the
# normal path on every start after the first. Any *other* error is real: treating
# them all as fine would turn a corrupt file into an empty-looking store.
#
# Returns 1 when the schema is in place, 0 when it is not.
fn agnostic_store_ensure(sql): i64 {
    if (_agnostic_store_db == 0) { return 0; }
    var rc = patra_exec(_agnostic_store_db, sql);
    if (rc == PATRA_OK) { return 1; }
    if (rc == PATRA_ERR_EXISTS) { return 1; }
    return 0;
}
