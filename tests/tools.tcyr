# agnostic/engine/tools — the M6 viability gate.
#
# The claim this suite holds: the preset tool vocabulary is a CHECKABLE
# contract, not a comment. Every one of the 38 names either resolves to
# something the engine can actually run, or is counted as unresolved by name.
# There is no third state, and in particular there is no "resolved to a
# best-effort substitute" — that is `ORACLE-AUDIT.md` §3.15, where a miss
# silently produced an agent with `tools=[]`.
include "src/app.cyr"

fn _t_registry() {
    var r = agnosai_tool_registry_new();
    agnosai_register_basic_builtins(r);
    agnosai_register_load_testing_builtin(r);
    agnosai_register_security_audit_builtin(r);
    return r;
}

fn test_vocabulary_is_pinned() {
    test_group("tools/vocabulary");

    agnostic_presets_init();
    # ⚠ Pinned deliberately. A preset edit that introduces a 39th tool name is a
    # decision — it must fail here and be made on purpose, not discovered when an
    # agent quietly comes up short.
    assert_eq(agnostic_preset_tool_count(), 38, "the library names 38 distinct tools");
    assert_eq(agnostic_preset_tool_is_named(str_from("LoadTestingTool")), 1,
      "LoadTestingTool is one of them");
    assert_eq(agnostic_preset_tool_is_named(str_from("NoSuchTool")), 0,
      "and an invented name is not");
}

fn test_alias_table() {
    test_group("tools/alias");

    agnostic_qa_tools_reset();
    assert_eq(agnostic_qa_alias_count(), 0, "no aliases before init");
    assert_eq(agnostic_qa_backend_name(str_from("LoadTestingTool")), 0,
      "and nothing resolves");

    agnostic_qa_tools_init();
    assert_eq(agnostic_qa_alias_count() > 0, 1, "init declares aliases");
    assert_eq(str_eq_cstr(agnostic_qa_backend_name(str_from("LoadTestingTool")),
        "load_testing"), 1, "LoadTestingTool is served by load_testing");
    assert_eq(str_eq_cstr(agnostic_qa_backend_name(str_from("SecurityAssessmentTool")),
        "security_audit"), 1, "SecurityAssessmentTool by security_audit");

    # ⭐ The naming vocabularies do NOT line up, and the table is what bridges
    # them. A case transform would map every name to something plausible and
    # most of them to nothing that exists — which is indistinguishable from
    # success until call time.
    assert_eq(agnostic_qa_backend_name(str_from("RiskScoringTool")), 0,
      "a name with no implementation has NO backend, rather than a guessed one");
    assert_eq(agnostic_qa_backend_name(str_from("ComprehensiveSecurityAssessmentTool")), 0,
      "and 'comprehensive' is NOT aliased to the plain security audit — a stronger claim than the backend makes");
    assert_eq(agnostic_qa_backend_name(0), 0, "a null name resolves to nothing");
}

fn test_resolution_against_a_real_registry() {
    test_group("tools/resolve");

    agnostic_presets_init();
    agnostic_qa_tools_init();
    var r = _t_registry();
    assert_neq(r, 0, "a registry stands up");
    assert_eq(agnosai_tool_registry_has(r, str_from("load_testing")), 1,
      "and holds the engine's load_testing");

    var t = agnostic_qa_tool_resolve(r, str_from("LoadTestingTool"));
    assert_neq(t, 0, "LoadTestingTool resolves");
    assert_eq(str_eq_cstr(agnosai_tool_name(t), "load_testing"), 1,
      "to the ENGINE's tool object — not a wrapper around it");
    assert_eq(agnostic_qa_tool_is_resolvable(r, str_from("SecurityAssessmentTool")), 1,
      "SecurityAssessmentTool resolves too");

    # ⭐ A MISS IS 0. Not a substitute, not the nearest match.
    assert_eq(agnostic_qa_tool_resolve(r, str_from("RiskScoringTool")), 0,
      "an unimplemented tool resolves to NOTHING");
    assert_eq(agnostic_qa_tool_resolve(r, str_from("NoSuchTool")), 0,
      "and so does a name no preset even uses");
    assert_eq(agnostic_qa_tool_resolve(0, str_from("LoadTestingTool")), 0,
      "a null registry resolves nothing");

    # ⚠ An alias whose backend the registry does NOT hold must read as
    # unresolved — reporting coverage and then failing at call time is worse
    # than reporting none.
    var bare = agnosai_tool_registry_new();
    assert_eq(agnostic_qa_tool_is_resolvable(bare, str_from("LoadTestingTool")), 0,
      "an alias is only resolvable if the registry actually holds its backend");
}

fn test_the_gate_counts_the_gap() {
    test_group("tools/gate");

    agnostic_presets_init();
    agnostic_qa_tools_init();
    var r = _t_registry();

    var resolved = agnostic_qa_resolved_count(r);
    var unresolved = agnostic_qa_unresolved_count(r);
    assert_eq(resolved + unresolved, agnostic_preset_tool_count(),
      "every preset name is either resolved or counted as missing — there is no third state");

    # ⚠ **This is the M6 progress number, and it is pinned so it can only move
    # deliberately.** 2 of 38 today. M6 is finished when `unresolved` is 0. If
    # this assertion fails because the number went DOWN, update it — that is the
    # milestone advancing. If it went UP, a preset gained a name nothing backs.
    assert_eq(resolved, 2, "2 of the 38 resolve today");
    assert_eq(unresolved, 36, "36 do not");

    # The gap is enumerable by name, in a stable order, so a diff means something.
    var first = agnostic_qa_unresolved_at(r, 0);
    assert_neq(first, 0, "the unresolved list is enumerable");
    assert_eq(agnostic_qa_unresolved_at(r, unresolved), 0, "and bounded");
    assert_eq(agnostic_qa_unresolved_at(r, 0 - 1), 0, "with no negative index");

    # ⭐ Every name the gate reports as unresolved really does resolve to 0 —
    # the count and the list cannot disagree.
    var i = 0;
    var mismatched = 0;
    while (i < unresolved) {
        if (agnostic_qa_tool_resolve(r, agnostic_qa_unresolved_at(r, i)) != 0) {
            mismatched = mismatched + 1;
        }
        i = i + 1;
    }
    assert_eq(mismatched, 0, "and each one genuinely resolves to nothing");
}

fn test_the_two_that_exist_nowhere() {
    test_group("tools/nonexistent");

    agnostic_presets_init();
    agnostic_qa_tools_init();
    var r = _t_registry();

    # ⚠ `ArtifactManagementTool` and `CIPipelineIntegrationTool` are named by
    # `quality-large.json` and have NO implementation in the oracle either —
    # unlike the other 36, which at least had a class. The roadmap requires them
    # to be written or struck from the preset; until that decision lands they
    # are unresolved like the rest, and this test is here so the decision cannot
    # be forgotten.
    assert_eq(agnostic_preset_tool_is_named(str_from("ArtifactManagementTool")), 1,
      "ArtifactManagementTool is still named by a preset");
    assert_eq(agnostic_preset_tool_is_named(str_from("CIPipelineIntegrationTool")), 1,
      "and so is CIPipelineIntegrationTool");
    assert_eq(agnostic_qa_tool_resolve(r, str_from("ArtifactManagementTool")), 0,
      "neither resolves");
    assert_eq(agnostic_qa_tool_resolve(r, str_from("CIPipelineIntegrationTool")), 0,
      "to anything");
}

fn main() {
    alloc_init();
    thread_local_init();
    test_vocabulary_is_pinned();
    test_alias_table();
    test_resolution_against_a_real_registry();
    test_the_gate_counts_the_gap();
    test_the_two_that_exist_nowhere();
    return assert_summary();
}

var _agnostic_tools_test_exit = main();
if (_agnostic_tools_test_exit > 0) { _agnostic_tools_test_exit = 1; }
sys_exit_group(_agnostic_tools_test_exit);
