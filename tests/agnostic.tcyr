# agnostic test suite
# Stdlib auto-included via cyrius.cyml

fn main() {
    alloc_init();
    test_group("smoke");
    assert(1, "true is true");
    assert_eq(1 + 1, 2, "math works");
    return assert_summary();
}

var _agnostic_test_exit_code = main();
# Clamp before exiting: assert_summary() returns the raw failure COUNT, and a
# wait status is only 8 bits — an unclamped 256 / 512 / 768 failures would exit
# 0 and score PASS. Any failure at all is exit 1.
if (_agnostic_test_exit_code > 0) { _agnostic_test_exit_code = 1; }
sys_exit_group(_agnostic_test_exit_code);
