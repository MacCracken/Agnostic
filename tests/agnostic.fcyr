# agnostic fuzz harness

fn fuzz_main(data, len) {
    if (len == 0) { return 0; }
    return 0;
}

fn main() {
    alloc_init();
    fuzz_main("test", 4);
    println("fuzz: ok");
    return 0;
}

# Prefixed for the same reason as the bench harness — see tests/agnostic.bcyr.
var _agnostic_fuzz_exit_code = main();
sys_exit_group(_agnostic_fuzz_exit_code);
